# Install as /etc/assay/assay.env. No provider/model key is needed by the server.
ASSAY_DEPLOYMENT=production
ASSAY_PUBLIC_URL=https://assay.qfinverse.com
ASSAY_MCP_HTTP=1
ASSAY_CORS_ORIGINS=https://assay.qfinverse.com
ASSAY_ACCOUNTS=1

# Writable local storage: research/library/cache, accounts and runtime config.
ASSAY_DATA_DIR=/var/lib/assay
ASSAY_STATE_DIR=/var/lib/assay/accounts
ASSAY_CONFIG_FILE=/var/lib/assay/config.json
# Prepared market data can be mounted read-only.
ASSAY_DATA_DIR_US=/srv/assay/market/us

# Optional service keys, supplied through your secret manager. Use distinct
# researcher/admin values; without admin keys a service key has legacy admin rights.
# ASSAY_API_KEYS=
# ASSAY_ADMIN_KEYS=

# The session secret is generated once under ASSAY_STATE_DIR unless overridden.
# Preserve it with the auth database across releases.
# ASSAY_SECRET_KEY=

OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
POLARS_MAX_THREADS=4

# Set by the release process, not by a client request.
# ASSAY_GIT_HASH=
# ASSAY_DEPLOYED_AT=
